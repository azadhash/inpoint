# Copy to .env and adjust. Everything here is optional except the Jira site.
# `inpoint login` writes the first three for you.

# Your Atlassian site. Used to build /browse/<KEY> and REST URLs.
JIRA_BASE_URL=https://yoursite.atlassian.net

# API token auth (optional). Without these, the browser flow is used instead.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# Where ticket folders get created: <ASSET_ROOT>/<PROJECT_KEY>/<TICKET_KEY>/
ASSET_ROOT=~/Desktop

# Where Chrome drops downloads before they get filed into the ticket folder.
DOWNLOADS_DIR=~/Downloads

# Scratch space for ad-hoc uploads made through the web UI.
WORK_DIR=~/Desktop/inpoint-work

# Whisper weights. 8-bit is ~0.9 GB and matches fp16 quality. Smaller:
#   mlx-community/whisper-large-v3-turbo-q4   ~0.5 GB, slightly rougher
#   mlx-community/whisper-small-mlx           ~0.5 GB, noticeably worse
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo-8bit

# Web UI bind address.
WEB_HOST=127.0.0.1
WEB_PORT=8765
